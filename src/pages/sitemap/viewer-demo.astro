---
import MainLayout from '../../layouts/MainLayout.astro';
import { productionUrl } from '../../data/site.js';
---

<MainLayout
  title="Sitemap Viewer Demo"
  path="/sitemap/viewer-demo.html"
  productionUrl={productionUrl}
>
  <p>
    This is the landing page for the demonstration sitemap on the
    <a href="https://sitemap-viewer.fileformat.info/">Sitemap Viewer</a>. There is no actual page
    with content: it is just a demo!
  </p>

  <p><a href="/sitemap/viewer-integration.html">Integration instructions</a></p>

  <p>
    <a
      href="https://sitemap-viewer.fileformat.info/view.html?url=https%3A%2F%2Fsitemap-viewer.fileformat.info%2Fdemo.xml&showmode=1&showlanguage=1&showexit=1&sort=name&return=/&showexit=1"
      >Return to the sitemap viewer</a
    >
  </p>
</MainLayout>
